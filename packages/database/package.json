{
  "name": "@recoverai/database",
  "version": "0.1.0",
  "private": true,
  "description": "Persistence layer for RecoverAI — repository implementations behind @recoverai/core ports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@recoverai/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
