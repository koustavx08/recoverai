{
  "name": "recoverai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered revenue recovery platform for merchants",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @recoverai/web dev",
    "dev:cli": "pnpm --filter @recoverai/cli dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run tests/e2e-cli.test.ts packages/agents/src/orchestration/pipeline.e2e.test.ts",
    "clean": "pnpm -r --if-present clean && rimraf node_modules",
    "recoverai": "node packages/cli/dist/index.js",
    "generate:data": "tsx scripts/generate-sample-data.ts",
    "evaluate:diagnosis": "tsx scripts/evaluate-diagnosis.ts",
    "evaluate:strategy": "tsx scripts/evaluate-strategy.ts",
    "evaluate:recovery": "tsx scripts/evaluate-recovery.ts",
    "evaluate:pipeline": "tsx scripts/evaluate-pipeline.ts"
  },
  "devDependencies": {
    "@recoverai/agents": "workspace:*",
    "@recoverai/config": "workspace:*",
    "@recoverai/core": "workspace:*",
    "@recoverai/integrations": "workspace:*",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "zod": "^3.24.1"
  }
}
