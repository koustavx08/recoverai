# RecoverAI — environment configuration
# Copy this file to .env and fill in values for your environment.
# Never commit a real .env file.

# --- Application ---------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (apps/web dashboard) -----------------------------------
# Signs/encrypts session JWTs (Auth.js) — required in every mode, including
# `next dev`; the server refuses every auth request with a "server
# configuration" error until this is set. Generate one with
# `npx auth secret` or `openssl rand -base64 33`.
#
# IMPORTANT: Next.js loads env files from apps/web/ itself, not the repo
# root — copy/create this as apps/web/.env.local (gitignored), not just a
# root .env, or the dashboard's auth will fail to start regardless of what
# the root .env contains.
AUTH_SECRET=
# Required only for `next start` (production mode) — Auth.js validates the
# request Host header against a trusted list once NODE_ENV=production, and
# rejects every request with "UntrustedHost" until this is set (or AUTH_URL
# is set to a fixed origin). Not needed for `next dev`.
AUTH_TRUST_HOST=true
# Shared password for the two demo dashboard logins seeded idempotently on
# first sign-in (see apps/web/lib/auth-seed.ts) — aurora@recoverai.dev and
# northwind@recoverai.dev, each scoped to one of the two merchants in
# data/samples/transactions.json. Change this (or delete the seeding
# helper entirely) before any real deployment — it is a demo/portfolio
# convenience, not a real account-provisioning flow.
DEMO_USER_PASSWORD=recoverai-demo

# --- Database -------------------------------------------------------------
# Connection string for the persistence layer (packages/database).
# Optional in development — createPrismaDatabase() defaults to a local
# SQLite file (packages/database/prisma/dev.db) when this is unset. Set it
# to point at a different SQLite file, or (after changing schema.prisma's
# datasource provider) a Postgres connection string.
DATABASE_URL=

# --- Razorpay ---------------------------------------------------------------
# Only required when packages/integrations is configured to use the live
# Razorpay provider instead of the simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI / Agent orchestration ------------------------------------------------
# The Diagnosis Agent (packages/agents) runs a deterministic rule-based
# fallback when these are unset — real LLM calls require both AI_API_KEY
# and AI_MODEL to be set. Only "anthropic" is implemented as a provider.
AI_PROVIDER=anthropic
AI_API_KEY=
# Example: claude-sonnet-5
AI_MODEL=

# --- Feature flags ----------------------------------------------------------
# Selects the active payment/recovery provider. "simulator" requires no
# credentials and is the default for local development.
PAYMENT_PROVIDER=simulator
